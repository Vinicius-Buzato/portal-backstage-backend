{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "size": {
      "type": "enumeration",
      "enum": [
        "span-12",
        "span-8",
        "span-6",
        "span-4"
      ]
    },
    "lead": {
      "type": "text"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "imageCaption": {
      "type": "string"
    },
    "body": {
      "type": "blocks"
    }
  }
}
